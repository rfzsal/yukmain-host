<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <StartupObject>YukMain.Host.Cli.Program</StartupObject>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>YukMain.Host</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../YukMain.Host.Core/YukMain.Host.Core.csproj" />
    <ProjectReference Include="../YukMain.Host.HidMaestro/YukMain.Host.HidMaestro.csproj" />
    <Compile Include="../YukMain.Host.Desktop/RemoteControllerReceiver.cs" Link="Engine/RemoteControllerReceiver.cs" />
    <Compile Include="../YukMain.Host.Desktop/RemoteInputPipeServer.cs" Link="Engine/RemoteInputPipeServer.cs" />
    <Compile Include="../YukMain.Host.Bridge/Program.cs" Link="Bridge/Program.cs" />
    <EmbeddedResource Include="../../docs/HIDMaestro-LICENSE.txt" LogicalName="YukMain.HIDMaestro.LICENSE.txt" />
    <EmbeddedResource Include="../../vendor/HIDMaestro/THIRD-PARTY-NOTICES.txt"
      Condition="Exists('../../vendor/HIDMaestro/THIRD-PARTY-NOTICES.txt')"
      LogicalName="YukMain.HIDMaestro.THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
</Project>