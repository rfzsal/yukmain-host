<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../YukMain.Host.Core/YukMain.Host.Core.csproj" />
    <Reference Include="HIDMaestro.Core">
      <HintPath>../../vendor/HIDMaestro/HIDMaestro.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckHidMaestroSdk" BeforeTargets="ResolveReferences" Condition="!Exists('$(MSBuildProjectDirectory)/../../vendor/HIDMaestro/HIDMaestro.Core.dll')">
    <Error Text="HIDMaestro.Core.dll is missing. Run powershell -File scripts/prepare-hidmaestro.ps1 first." />
  </Target>
</Project>
